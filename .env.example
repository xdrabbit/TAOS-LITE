# --- Required ---
OPENAI_API_KEY=your_openai_api_key

# --- Speech-to-text (OpenAI) ---
# gpt-4o-transcribe (most accurate) | gpt-4o-mini-transcribe (cheaper) | whisper-1
# These are completed-file paths. gpt-live-transcribe requires Realtime and is
# not a drop-in value for the file-upload knobs below.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Home's Auto-detect turns only (PR #109); unset = OPENAI_TRANSCRIBE_MODEL.
# OPENAI_AUTO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Short-transcript retry (lib/translate/shortTranscript.ts): when a transcript
# is under 0.4 words/s on a clip of 8 s or more, the same audio is run ONCE
# through this model, hinted toward the pair's other language. whisper-1
# retires 2027-02-26; gpt-transcribe is the compatible file-transcription
# successor. Leave the default until language-hint parity is verified.
# TAOS_TRANSCRIBE_FALLBACK_MODEL=whisper-1
# /video's timestamped captions use a separate model because they require
# verbose_json segments. Keep whisper-1 until successor timestamp parity is
# implemented and verified; a model-name-only flip loses that contract.
# OPENAI_CAPTION_STT_MODEL=whisper-1
# Quiet normalize (lib/translate/normalize.ts): peak-normalize the clip with
# ffmpeg before transcription. 1 = everyone, 0 = nobody (and the ffmpeg binary
# is left out of the build), unset = founders only. norm_gain_db= on the
# [taos-translate-timing] line says what it did.
# TAOS_STT_NORMALIZE=

# --- /review second opinion (founders only, on demand) ---
# The SECOND transcriber a kept clip is re-read with (word-diffed against the
# turn's transcript). whisper-1 retires 2027-02-26; keep it until language-hint
# parity is verified, then use a compatible successor.
# TAOS_REVIEW_STT_MODEL=whisper-1
# Ordered alternatives if the preferred model produced the original turn.
# Comma-separated; defaults to the three values shown here.
# TAOS_REVIEW_STT_FALLBACK_MODELS=whisper-1,gpt-4o-mini-transcribe,gpt-4o-transcribe
# The grader (strict JSON: meaning, tone, issues, suggested translation).
# Default: the study lessons' model (lib/study/lesson.ts). No temperature is sent.
# TAOS_REVIEW_GRADER_MODEL=gpt-5.5
# How many turns one "Check all unreviewed on this day" click sends (max 200).
# TAOS_REVIEW_BATCH_MAX=50
# Opt-in nightly pass over the last day's unreviewed kept turns, on the walkie
# cron. Off unless 1.
# TAOS_REVIEW_NIGHTLY=0

# --- Concept paraphrase (OpenAI) ---
# Spoken /translate turns: full gpt-4.1 — mini drifted meaning in casual mode
# (7/23 field report). This route ignores OPENAI_PARAPHRASE_MODEL on purpose.
OPENAI_TRANSLATE_MODEL=gpt-4.1
# Latency-sensitive text routes (/live readouts, chat, typed translate):
OPENAI_PARAPHRASE_MODEL=gpt-4.1-mini
# Photo translator (/vision). Optional; falls back to OPENAI_TRANSLATE_MODEL.
# OPENAI_VISION_MODEL=gpt-4.1

# --- Text-to-speech: ElevenLabs (default engine) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Any voice works; eleven_turbo_v2_5 is multilingual + low latency.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Cantonese output only: turbo/flash can't speak Cantonese; v3 can (slower).
ELEVENLABS_YUE_MODEL=eleven_v3
# The cloned voices: Tom for EN->ES, Liz for ES->EN. The MAPPING is pinned in
# code (lib/tts/voice.ts) so it can't get crossed by env again, and so is
# Tom's id. Liz's id is config, because hers is the one that gets retrained —
# 8/23 shipped the wrong voice as a code constant and only Tom's ears caught
# it. Unset = Liz falls back to the stock voice above and the server log says
# so; there is deliberately no hardcoded fallback id.
ELEVENLABS_LIZ_VOICE_ID=her_elevenlabs_voice_id
# Fish Audio (fish.audio) — the same two clones, the home screen's default
# engine for subscribers since 10/06. The voice ids are each model's 32-hex
# _id, NOT its title ("Tom"/"Lizma" are refused). API credit is separate from
# the app's credit at fish.audio/app/developers; empty = every call 402s.
# No Fish clone for a line (locked phone, guest) = the ElevenLabs stock voice.
FISHAUDIO_API_KEY=your_fish_audio_api_key
FISHAUDIO_TOM_VOICEID=his_fish_model_id
FISHAUDIO_LIZ_VOICEID=her_fish_model_id
# Optional; default s2.1-pro.
FISHAUDIO_MODEL=s2.1-pro
# Shared secret that unlocks those cloned voices on Tom's and Liz's phones
# (5 taps on the TAOS·LITE title -> type the code). Everyone else gets the
# multilingual voice above. Unset = nobody gets a clone; set it in Vercel for
# BOTH Production and Preview. Long and random: there's no rate limit.
TAOS_PERSONAL_VOICE_CODE=your_long_random_personal_voice_code

# --- Text-to-speech: OpenAI (alternate engine) ---
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# --- Text-to-speech: Google Cloud (flagged alternate engine) ---
TAOS_TTS_GOOGLE_ENABLED=0
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key
# standard | wavenet | neural2 | chirp3 (default)
GOOGLE_TTS_TIER=chirp3
# Chirp 3 HD voice name shared across supported locales.
GOOGLE_TTS_CHIRP3_VOICE=Kore
# Spoken "Traducido con TAOS" / "Translated with TAOS" at the end of a free-tier
# user's shared mp3 (home card Share only; never Play, never subscribers).
# Uses GOOGLE_TTS_API_KEY even when TAOS_TTS_GOOGLE_ENABLED=0. Off unless 1.
TAOS_SHARE_SIGNOFF=0

# --- Supabase (auth + profiles/history) ---
# Public, safe-to-ship values (defaults are baked into the code):
NEXT_PUBLIC_SUPABASE_URL=https://duqkmuaceklnfgvoufrz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_LBhw7XTAhPWjNhbmjcf3uA_r_tbaALD
# SECRET — server only (Stripe webhook updates profiles). Do NOT prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- v1 release gate (lib/release.ts) ---
# Founders see the held-back screens (/call, /video). /tabletop is customer-facing.
# Tom and Liz are hardcoded; add others here, comma-separated:
# NEXT_PUBLIC_FOUNDER_EMAILS=liz@example.com
#
# /call's outside test pairs: /call and nothing else. SERVER-ONLY (never add a
# NEXT_PUBLIC_ copy). Unset/empty/malformed grants nobody. NEXT_PUBLIC_ENABLE_CALL
# stays off. Runbook: ENHANCEMENTS.md, "/call test pairs".
# CALL_ALLOWLIST_EMAILS=ana@example.com, ben@example.com
#
# /tutor is pulled from RC1 — hidden from EVERYONE (founders too), its route
# redirects to /, and its three API routes 404. It is unfinished and is the
# planned premium feature. Set this to 1 and redeploy to bring it back; the
# code and course content never left.
# NEXT_PUBLIC_ENABLE_TUTOR=1

# --- Stripe (paywall) ---
# SECRET — server only.
STRIPE_SECRET_KEY=sk_test_your_secret_key
# SECRET — from the Stripe webhook endpoint you create.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Subscription + add-on pack price ids (not secret). Default to the TEST prices
# in code; set these to your LIVE price ids in production.
STRIPE_PRICE_BASIC=price_basic_5_99_monthly
STRIPE_PRICE_PREMIUM=price_premium_19_99_monthly
STRIPE_PACK_100=price_pack_100min_one_time
STRIPE_PACK_200=price_pack_200min_one_time

# --- /call TURN relay (Cloudflare Realtime; used by /api/call/ice) ---
# Without these, /call is STUN-only: it connects two phones that have any
# direct path to each other and fails on the pairs that do not (two carrier
# NATs — the 2026-08-31 field report). The route degrades to STUN and the
# screen says "no relay"; it does not fail and does not pretend.
#
# Server-side ONLY. Never NEXT_PUBLIC_: a TURN credential inlined into the
# browser bundle is a free relay for anyone who reads view-source. The route
# mints a one-hour credential per call instead.
#
# Cloudflare dashboard -> Realtime -> TURN Keys. $0.05/GB egress with the
# first 1,000 GB free, and billed only when peer-to-peer fails; the arithmetic
# is in docs/realtime-cost-model.md.
# CLOUDFLARE_TURN_KEY_ID=your_cloudflare_turn_key_id
# CLOUDFLARE_TURN_API_TOKEN=your_cloudflare_turn_api_token
# How long a minted credential lives. Default 3600 (an hour) — long enough to
# outlive a call and a mid-call ICE restart.
# CLOUDFLARE_TURN_TTL_SECONDS=3600

# --- Taokie: the push-to-talk translation walkie (founders-only P0 spike) ---
# SERVER-ONLY flag (lib/walkie/flag.ts): the page and every /api/walkie route
# read it; unset = 404 everywhere and no nav tile opens anything. Founders
# only on top of it. Preview branches only until the two-phone test passes.
# TAOS_WALKIE_ENABLED=1
# Hold-to-talk hard cap in ms (auto-sends at the cap). Default 30000.
# TAOS_WALKIE_MAX_TURN_MS=30000
# How long a turn's audio + text are kept before GET /api/walkie/sweep (daily
# Vercel Cron, CRON_SECRET) deletes them. Default 30.
# TAOS_WALKIE_RETENTION_DAYS=30

# --- Release flags (lib/release.ts); off unless explicitly 1/true ---
# NEXT_PUBLIC_ENABLE_CALL=1
# NEXT_PUBLIC_ENABLE_ONDEVICE_STT=1
# Tutor: NEXT_PUBLIC_ENABLE_TUTOR=1 is already documented above.
#
# /fast's own mic — PARKED 2026-08-31, and off for founders too. It worked on
# Android and was dead on iPhone after three rounds of fixes, so the platform
# keyboard's mic replaced it. Setting this brings back the whole streaming
# stack: the dock component, useLiveDictation, micCapture, and the three
# routes below (/api/fast/listen, /api/fast/speech-token,
# /api/fast/speech-settle), which 404 everyone while it is unset. See the
# forensic note in ENHANCEMENTS.md before flipping it — an Android-only
# revival is the case it was parked FOR.
# NEXT_PUBLIC_ENABLE_FAST_MIC=1

# --- Azure Speech (ONE resource, two features) ---
# /api/tutor/assess  -> Crawl pronunciation numbers.
#                       Unset = crawl degrades to unscored phrases.
# /api/fast/speech-token -> the parked LIVE mic on /fast. This route mints a
#                       10-minute token so the browser can open its own
#                       recognition socket; the key below never leaves the
#                       server. Dark unless NEXT_PUBLIC_ENABLE_FAST_MIC=1, and
#                       even then, unset = the mic falls back to batch Whisper.
# NOTE: this is a Speech resource. It is NOT AZURE_TRANSLATOR_KEY/REGION (a
# different resource kind, further down) — crossing the two returns a 401.
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_speech_region

# --- Optional tutor / realtime model overrides ---
# OPENAI_TUTOR_LESSON_MODEL=gpt-4.1
# OPENAI_TUTOR_REALTIME_MODEL=gpt-realtime-mini
# OPENAI_REALTIME_VOICE=marin
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- /fast: the word-for-word quickie box (founders-only at launch) ---
# Ship it to everyone (lib/release.ts). Off unless explicitly 1/true:
# NEXT_PUBLIC_ENABLE_FAST=1
#
# Azure Translator — the PRIMARY engine for /fast, and a SEPARATE Azure
# resource from the Speech one above (a Speech key sent to the Translator API
# comes back 401). Unset = /fast still works on a literal-prompted OpenAI
# model and says so on screen; it does not fail and does not pretend.
# Full setup steps, and the measured bake-off that chose this, are in
# docs/fast-engine.md.
# AZURE_TRANSLATOR_KEY=your_azure_translator_key
# AZURE_TRANSLATOR_REGION=your_azure_translator_region
#
# The literal fallback model. NOT OPENAI_PARAPHRASE_MODEL: that var tunes the
# CONVERSATIONAL routes, and /fast's whole register is the opposite of theirs.
# Defaults to gpt-5.6-luna. Luna/reasoning models are sent no temperature.
# OPENAI_FAST_MODEL=gpt-5.6-luna
#
# Server-side ceiling on the as-you-type endpoint, per account
# (lib/fast/rateLimit.ts). Defaults 60 and 600.
# TAOS_FAST_RATE_PER_MINUTE=60
# TAOS_FAST_RATE_PER_HOUR=600
